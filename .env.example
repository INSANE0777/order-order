# Copy to .env and fill in. Never commit .env.
# Everything large (corpus, venv, caches, database volume) lives under this directory. It reaches a
# few gigabytes, so give it an absolute path on a drive with room rather than the default below.
ORDERORDER_DATA_DIR=data

# Database. Empty means SQLite inside ORDERORDER_DATA_DIR (metadata, citations, checkpoints; no vectors).
# Postgres with pgvector is needed for embeddings and hybrid search:
# DATABASE_URL=postgresql+psycopg://orderorder:orderorder@localhost:5432/orderorder
DATABASE_URL=

# Language models, as LangChain provider strings. Free tiers, see docs/TECH_STACK.md section 5.
# Primary handles demo data and bulk. Fallbacks are tried in order on rate limits or errors.
#
# Check the *daily* cap on a free tier before starting an evaluation, and not only the per-minute one.
# `--pace` spaces calls out across a minute and does nothing about a day. `gemini-3.6-flash` allows 20
# requests a day free, while `orderorder eval contrary --read 20` makes forty: it exhausts the quota
# partway and records every call after it as `unread`. That is the engine behaving correctly -- a
# provider failure is not a judgement about the texts -- but a report that is mostly `unread` is a
# quota failure and not a result. `orderorder doctor --probe` names the reason in a single call, so
# run it first when a report comes back emptier than the last one.
LLM_PRIMARY=google_genai:gemini-2.5-flash
# `qwen3.5:4b` needs a newer ollama than 0.11.4, which refuses the pull with a 412 and a message
# about upgrading. `qwen3:4b` is 2.5 GB and works on it. Either way, set OLLAMA_MODELS *before*
# starting the server, or the pull lands wherever ollama defaults to on the system drive.
LLM_FALLBACKS=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,ollama:qwen3:4b
# The only provider allowed for whole-judgment digests (needs a long context).
LLM_LONG_CONTEXT=google_genai:gemini-2.5-flash
# The only provider allowed for text that is not demo data (does not train on inputs).
LLM_SENSITIVE=groq:openai/gpt-oss-120b

# An OpenAI-compatible endpoint for `openai:` provider strings: a router or gateway, or the
# self-hosted SGLang/vLLM server in the production profile. Leave empty to talk to OpenAI itself.
# The model half of the provider string is whatever that endpoint calls the model:
#   LLM_PRIMARY=openai:qwen/qwen3-32b
# LLM_BASE_URL=https://example-router.invalid/api/v1
#
# A locally run gateway (OmniRoute, LiteLLM, or your own SGLang box) is the same three lines:
#   LLM_BASE_URL=http://localhost:20128/v1
#   LLM_PRIMARY=openai:<whatever that gateway calls the model>
#   OPENAI_API_KEY=<the gateway's own key>
# Then run `orderorder doctor --probe`. It makes one real call and reports whether a filled schema
# came back. Every model call in this engine is schema-bound, and an endpoint that accepts the
# request but answers in prose does not fail loudly: extent of support, weight and applicability all
# quietly become "not assessed". Check before trusting a route, and check again if it changes.

# Provider keys (each team member creates their own; the fallback chain alternates between them).
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Indian Kanoon API (lookup, fragments, cited-by). Apply for the non-commercial allowance.
INDIANKANOON_TOKEN=
INDIANKANOON_DAILY_QUOTA=200

# Local models (phase 2 of the build; not needed for the data spine).
EMBEDDINGS_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_MODELS=data/ollama

# Tracing: LangSmith Developer plan during the hackathon (demo data only).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderorder

# Tooling caches. uv and huggingface read these from the environment rather than from this file,
# so `scripts/dev-env.sh` (or `dev-env.ps1`) is what sets them, all under ORDERORDER_DATA_DIR:
#   UV_CACHE_DIR, UV_PYTHON_INSTALL_DIR, UV_PROJECT_ENVIRONMENT, HF_HOME
